{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1
      },
      "profile": {
        "enum": [
          "go",
          "swift"
        ]
      },
      "verifyTask": {
        "type": "string",
        "pattern": "^project:verify:[a-z][a-z0-9-]*$"
      }
    },
    "required": [
      "path",
      "profile",
      "verifyTask"
    ]
  }
}

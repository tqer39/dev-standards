{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "standard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "repository",
        "version"
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "macos",
          "linux",
          "windows"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\:][^\\\\:]*$",
            "not": {
              "pattern": "(^|/)\\.\\.(/|$)"
            }
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "required": [
          "name",
          "path",
          "profile"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "enum": [
              "codexcli",
              "claudecode",
              "copilot",
              "cursor"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "instructions": {
          "enum": [
            "rulesync"
          ]
        }
      },
      "required": [
        "targets"
      ]
    },
    "gitignore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "templates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "local": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\:][^\\\\:]*$",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      },
      "required": [
        "templates",
        "local"
      ]
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": {
          "const": "stable"
        },
        "allowMajor": {
          "type": "boolean"
        },
        "rollout": {
          "enum": [
            "canary",
            "standard",
            "manual"
          ]
        }
      },
      "required": [
        "channel",
        "allowMajor",
        "rollout"
      ]
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prBudgetSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "minimumSamples": {
          "type": "integer",
          "minimum": 5
        },
        "breachWindows": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "prBudgetSeconds",
        "minimumSamples",
        "breachWindows"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "standard",
    "platforms",
    "components",
    "ai",
    "gitignore",
    "update",
    "ci"
  ]
}
